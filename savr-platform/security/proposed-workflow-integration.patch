@@ -105,8 +107,25 @@ jobs:
       - name: Install dependencies
         run: npm ci
 
-      - name: Run dependency audit
-        run: npm audit --audit-level=high
+      # Full, unfiltered report (devDependencies included) so every advisory
+      # stays visible. Enforcement happens in the next step.
+      - name: Dependency audit report (informational)
+        run: npm audit || true
+
+      # ADR-005: same --audit-level=high semantics, except the exact approved
+      # records in savr-platform/security/audit-exceptions.json. Fails on any
+      # other high/critical advisory, a new path or version, an expired or
+      # unused record, or a published upstream fix.
+      - name: Enforce audit gate (ADR-005)
+        run: node ../security/audit-gate.mjs --workspace ${{ matrix.package }}
+
+      - name: Exception control — web lint rootDir unset (ADR-005)
+        if: matrix.package == 'web'
+        run: node ../security/exception-controls.mjs web-lint-root-dir eslint.config.mjs
+
+      - name: Exception control — mobile update code signing unset (ADR-005)
+        if: matrix.package == 'mobile'
+        run: node ../security/exception-controls.mjs mobile-update-signing app.config.ts app.json
 
