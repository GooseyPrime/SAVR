# ====================================================================
# SAVR Environment Variables Configuration
# ====================================================================
# This file contains all environment variables needed for local development
# and deployment. For GitHub Actions secrets setup, see:
# GITHUB_SECRETS_SETUP.md
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local for Next.js web app
# 2. Replace placeholder values with your actual credentials
# 3. Never commit .env.local to version control (it's in .gitignore)
# ====================================================================

# ====================================================================
# SUPABASE CONFIGURATION (Required - Mixed Sensitivity)
# ====================================================================
# Get these from Supabase Dashboard > Project Settings > API
# Source: https://app.supabase.com/
# URL and Anon Key are safe to expose in client-side code
# Service Role Key is SENSITIVE - server-side only!

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ====================================================================
# OPENAI CONFIGURATION (Required - Sensitive)
# ====================================================================
# Get your API key from: https://platform.openai.com/api-keys
# Used for: Image analysis, recipe generation, meal planning, AI chat
# IMPORTANT: Keep this secret! Never commit to code or expose client-side

OPENAI_API_KEY=your_openai_api_key

# ====================================================================
# GOOGLE CLOUD VISION API (Optional - Sensitive)
# ====================================================================
# Get from: https://console.cloud.google.com/ > APIs & Services > Credentials
# Used as fallback for image analysis if OpenAI Vision fails
# IMPORTANT: Keep this secret!

GOOGLE_CLOUD_VISION_API_KEY=your_google_vision_api_key

# ====================================================================
# STRIPE CONFIGURATION (Required - Mixed Sensitivity)
# ====================================================================
# Get from: https://dashboard.stripe.com/apikeys
# Publishable key: Safe to expose client-side
# Secret key: SENSITIVE - keep private!
# Webhook secret: Get from Stripe Dashboard > Webhooks

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ====================================================================
# STRIPE PRICING TABLE (Required - Public)
# ====================================================================
# Get from: https://dashboard.stripe.com/products/pricing-tables
# This is the ID of your Stripe Pricing Table embed.
# Create a pricing table in the Stripe Dashboard with your subscription
# products and pricing. The table ID starts with "prctbl_".
# IMPORTANT: Set metadata.tier='basic' or 'pro' on each price in the
# Stripe Dashboard so the backend can determine the subscription tier.

NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=prctbl_your_pricing_table_id

# ====================================================================
# APPLICATION CONFIGURATION (Required - Public)
# ====================================================================
# Your production domain URL (no trailing slash)

NEXT_PUBLIC_APP_URL=https://savr.cam

# ====================================================================
# VARIABLE SUMMARY
# ====================================================================
# Total: 10 variables
# - Supabase: 3 (2 public, 1 sensitive)
# - OpenAI: 1 (sensitive)
# - Google Vision: 1 (sensitive, optional)
# - Stripe Keys: 3 (2 sensitive, 1 public)
# - Stripe Pricing Table: 1 (public)
# - App Config: 1 (public)
#
# Sensitive variables: SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY,
#                     GOOGLE_CLOUD_VISION_API_KEY, STRIPE_SECRET_KEY,
#                     STRIPE_WEBHOOK_SECRET
# ====================================================================
